function Set-FixedDevice {
  param([string]$Id)
  if($Fixed -and $Id -ne "default"){
    $global:LastDevice = $Id
    Write-Host "[fixed_device] Bloqueado a: $Id" -F Magenta
  }
}

# --- Clipboard robusto (robust_clipboard) ---
function Copy-Robust {
  param([string]$Text)
  $retry=0
  while($retry -lt 3){
    try {
      Set-Clipboard -Value $Text -ErrorAction Stop
      [System.Windows.Forms.Clipboard]::SetText($Text)
      Write-Host "[clipboard] Copiado ($($Text.Length) chars)" -F Green
      return $true
    } catch {
      Start-Sleep -Milliseconds 150; $retry++
    }
  }
  return $false
}

# --- Speech engine (final + autonomous) ---
$recog = New-Object System.Speech.Recognition.SpeechRecognitionEngine($Lang)
$recog.SetInputToDefaultAudioDevice()
$recog.LoadGrammar((New-Object System.Speech.Recognition.DictationGrammar))
$recog.InitialSilenceTimeout = [TimeSpan]::FromSeconds(4)
$recog.BabbleTimeout = [TimeSpan]::FromSeconds(3)

# Puntuacion inteligente
function Invoke-AutoPunct {
  param([string]$t)
  if(-not $AutoPunct){ return $t }
  $t = $t -replace "\\s+punto",". " -replace "\\s+coma",", " -replace "nueva linea","\`n"
  return $t.Trim()
}

# Filtro muletillas
$fillers = @("eh","mmm","este","ehh")
function Remove-Fillers {
  param([string]$t)
  foreach($f in $fillers){ $t = $t -replace "\\b$f\\b","" }
  return ($t -replace "\\s{2,}"," ").Trim()
}

# Eventos
Register-ObjectEvent -InputObject $recog -EventName SpeechRecognized -Action {
  $raw = $EventArgs.Result.Text
  $conf = $EventArgs.Result.Confidence
  $clean = Invoke-AutoPunct $raw
  $clean = Remove-Fillers $clean
  $global:Transcript += " $clean"
  $global:Confidence.Add($conf)
  Write-Host "[final] $clean (conf=$([math]::Round($conf*100))%)" -F White
  if($Clipboard){ Copy-Robust $clean | Out-Null }
} | Out-Null

Register-ObjectEvent -InputObject $recog -EventName SpeechRecognitionRejected -Action {
  Write-Host "[interim] ... no reconocido" -F DarkGray
} | Out-Null

# --- Hotkey Ctrl+Space (ctrl_space.ps1) ---
$hotkeyForm = New-Object System.Windows.Forms.Form
$hotkeyForm.ShowInTaskbar = $false
$hotkeyForm.WindowState = "Minimized"
$hotkeyForm.Add_KeyDown({
  if($_.Control -and $_.KeyCode -eq "Space"){
    $global:Running = -not $global:Running
    if($global:Running){ $recog.RecognizeAsync([System.Speech.Recognition.RecognizeMode]::Multiple) }
    else { $recog.RecognizeAsyncStop() }
    Write-Host "[ctrl_space] Toggle -> $global:Running" -F Cyan
  }
})

# --- Main ---
Ensure-Persist
if($DeviceId -ne "default"){ Set-FixedDevice $DeviceId }
Write-Host "DICTATE v10 Unificada | Lang=$Lang | Auto=$Autonomous | Clip=$Clipboard | Fixed=$Fixed" -F Magenta
Write-Host "Atajo: Ctrl+Space | Device: $global:LastDevice" -F Gray

$recog.RecognizeAsync([System.Speech.Recognition.RecognizeMode]::Multiple)
try {
  while($true){ [System.Windows.Forms.Application]::DoEvents(); Start-Sleep -Milliseconds 80 }
} finally {
  $recog.Dispose()
}
