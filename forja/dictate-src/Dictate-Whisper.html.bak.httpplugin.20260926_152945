  <script>
(function(){
  const WHISPER_URL = 'http://127.0.0.1:8081/api/transcribe';
  const CHUNK_MS = 4000;

  // Si ya existe SpeechRecognition nativo, no hacemos nada.
  if (window.SpeechRecognition || window.webkitSpeechRecognition) {
    console.log('[DICTATE] Web Speech API nativa detectada, no se instala shim');
    return;
  }

  class WhisperSpeechRecognition {
    constructor() {
      this.continuous = false;
      this.interimResults = false;
      this.lang = 'es-MX';
      this.maxAlternatives = 1;
      this.onresult = null;
      this.onerror = null;
      this.onend = null;
      this._recording = false;
      this._mediaRecorder = null;
      this._stream = null;
      this._chunks = [];
      this._chunkTimer = null;
      this._mimeType = 'audio/webm';
    }

    async start() {
      if (this._recording) return;
      try {
        this._stream = await navigator.mediaDevices.getUserMedia({
          audio: { echoCancellation: true, noiseSuppression: true, autoGainControl: true }
        });
        if (window.MediaRecorder && MediaRecorder.isTypeSupported('audio/webm;codecs=opus')) {
          this._mimeType = 'audio/webm;codecs=opus';
        }
        this._recording = true;
        this._spawnRecorder();
        this._chunkTimer = setInterval(() => {
          if (this._mediaRecorder && this._mediaRecorder.state === 'recording') {
            this._mediaRecorder.stop();
          }
        }, CHUNK_MS);
        console.log('[DICTATE] Whisper shim: grabando');
      } catch(e) {
        console.error('[DICTATE] start error:', e);
        if (this.onerror) this.onerror({ error: 'not-allowed', message: e.message });
      }
    }

    _spawnRecorder() {
      try {
        this._mediaRecorder = new MediaRecorder(this._stream, { mimeType: this._mimeType });
        this._chunks = [];
        this._mediaRecorder.ondataavailable = (e) => {
          if (e.data && e.data.size > 0) this._chunks.push(e.data);
        };
        this._mediaRecorder.onstop = async () => {
          if (this._chunks.length === 0) {
            if (this._recording && this.continuous) this._spawnRecorder();
            return;
          }
          const blob = new Blob(this._chunks, { type: this._mimeType });
          this._chunks = [];
          await this._transcribe(blob);
          if (this._recording && this.continuous) this._spawnRecorder();
        };
        this._mediaRecorder.start();
      } catch(e) {
        console.error('[DICTATE] spawnRecorder error:', e);
      }
    }

    async _transcribe(blob) {
      try {
        const form = new FormData();
        form.append('audio', blob, 'chunk.webm');
        const r = await fetch(WHISPER_URL, { method: 'POST', body: form });
        if (!r.ok) throw new Error('HTTP ' + r.status);
        const j = await r.json();
        const txt = (j.text || '').trim();
        if (!txt) return;

        // Construir evento compatible con SpeechRecognitionEvent
        const alt = { transcript: txt, confidence: 0.95 };
        alt.length = 1; alt[0] = alt;
        const res = { isFinal: true, length: 1, 0: alt };
        const evt = {
          resultIndex: 0,
          results: Object.assign([res], { length: 1, 0: res })
        };
        if (this.onresult) this.onresult(evt);
      } catch(e) {
        console.error('[DICTATE] transcribe error:', e);
        if (this.onerror) this.onerror({ error: 'network', message: e.message });
      }
    }

    stop() {
      this._recording = false;
      if (this._chunkTimer) { clearInterval(this._chunkTimer); this._chunkTimer = null; }
      if (this._mediaRecorder && this._mediaRecorder.state !== 'inactive') {
        this._mediaRecorder.stop();
      }
      if (this._stream) {
        this._stream.getTracks().forEach(t => t.stop());
        this._stream = null;
      }
      if (this.onend) setTimeout(() => this.onend(), 100);
      console.log('[DICTATE] Whisper shim: detenido');
    }

    abort() { this.stop(); }
  }

  window.SpeechRecognition = WhisperSpeechRecognition;
  window.webkitSpeechRecognition = WhisperSpeechRecognition;
  console.log('[DICTATE] Whisper shim instalado — backend:', WHISPER_URL);
})();
