<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Runeforge Dashboard</title>
    <style>
        body { background: #0D0211; color: #E2D6EE; font-family: 'Courier New', monospace; margin: 0; }
        #nav { display: flex; gap: 10px; padding: 10px; background: #15051C; border-bottom: 1px solid #39FF14; flex-wrap: wrap; }
        #nav button { background: transparent; border: 1px solid #BD00FF; color: #E2D6EE; padding: 8px 16px; border-radius: 6px; cursor: pointer; font-family: inherit; }
        #nav button.active { background: #39FF14; color: #0D0211; border-color: #39FF14; }
        #iframe-container { height: calc(100vh - 70px); width: 100%; }
        iframe { width: 100%; height: 100%; border: none; }
    </style>
</head>
<body>
    <div id="nav">
        <button class="active" data-page="forge">Bitácora PRO</button>
        <button data-page="mission">Mission Control</button>
        <button data-page="control">Control IA</button>
        <button data-page="pwa">PWA Offline</button>
        <button data-page="acceso">Acceso iPhone</button>
        <button data-page="deepseek">DeepSeek</button>
        <button data-page="infograma">Infografía</button>
        <button data-page="roadmap">Roadmap</button>
        <button data-page="chat">Chat Simple</button>
    </div>
    <div id="iframe-container">
        <iframe id="mainFrame" src="/pages/forge.html"></iframe>
    </div>
    <script>
        const buttons = document.querySelectorAll('#nav button');
        const iframe = document.getElementById('mainFrame');
        buttons.forEach(btn => {
            btn.addEventListener('click', function() {
                buttons.forEach(b => b.classList.remove('active'));
                this.classList.add('active');
                iframe.src = '/pages/' + this.dataset.page + '.html';
            });
        });
    </script>
</body>
</html>
