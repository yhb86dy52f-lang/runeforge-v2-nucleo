NODE_ENV=development
PORT=3100
RUNEFORGE_NAME=Runeforge
RUNEFORGE_ALLOWED_COMMANDS=ping,status,echo,time,gps_status,leer_apn,leer_inbound_ip,leer_inbound_port
RUNEFORGE_DEFAULT_APN=PENDIENTE
RUNEFORGE_DEFAULT_INBOUND_IP=PENDIENTE
RUNEFORGE_DEFAULT_INBOUND_PORT=PENDIENTE

# AI
AI_PROVIDER=openai
AI_API_KEY=CHANGE_ME
AI_MODEL=CHANGE_ME

# WhatsApp Cloud API
WHATSAPP_ENABLED=false
WHATSAPP_VERIFY_TOKEN=CHANGE_ME
WHATSAPP_ACCESS_TOKEN=CHANGE_ME
WHATSAPP_PHONE_NUMBER_ID=CHANGE_ME
WHATSAPP_APP_SECRET=CHANGE_ME
