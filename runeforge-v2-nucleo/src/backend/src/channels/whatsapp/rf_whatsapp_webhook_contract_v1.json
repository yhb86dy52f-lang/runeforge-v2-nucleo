{
    "rf_schema":  "rf.whatsapp.webhook.contract.v1",
    "mode":  "DRYRUN_ONLY",
    "channel_role":  "ADAPTER_ONLY",
    "verify":  {
                   "query":  [
                                 "hub.mode",
                                 "hub.verify_token",
                                 "hub.challenge"
                             ],
                   "method":  "GET",
                   "path":  "/webhooks/whatsapp",
                   "behavior":  "validate verify token and return challenge"
               },
    "receive":  {
                    "method":  "POST",
                    "path":  "/webhooks/whatsapp",
                    "behavior":  "ack 200, normalize message, create trace, route safely"
                },
    "send_text":  {
                      "method":  "POST",
                      "real_send":  "BLOCKED_IN_DRYRUN",
                      "graph_api":  "/{PHONE_NUMBER_ID}/messages"
                  }
}
