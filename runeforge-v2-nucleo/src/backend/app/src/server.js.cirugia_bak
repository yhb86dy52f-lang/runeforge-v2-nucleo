// ================================================================
// RUNEFORGE — BACKEND OPTIMIZADO (PRODUCTION-READY)
// ================================================================

const Fastify = require('fastify');
const path = require('path');
const fs = require('fs');
const cors = require('@fastify/cors');
const dotenv = require('dotenv');
const envSchema = require('env-schema');
const { Type } = require('@sinclair/typebox');

const schema = Type.Object({
  PORT: Type.Number({ default: 3100 }),
  HOST: Type.String({ default: '0.0.0.0' }),
  OLLAMA_URL: Type.String({ default: 'http://localhost:11434' }),
  OLLAMA_MODEL: Type.String({ default: 'qwen2.5:1.5b' }),
  LOG_LEVEL: Type.Union([
    Type.Literal('trace'), Type.Literal('debug'), Type.Literal('info'),
    Type.Literal('warn'), Type.Literal('error'), Type.Literal('fatal')
  ], { default: 'info' }),
  CORS_ORIGIN: Type.String({ default: '*' }),
  NODE_ENV: Type.String({ default: 'development' })
});

dotenv.config({ path: path.join(__dirname, '../../.env') });
const config = envSchema({
  schema,
  data: {
    ...process.env,
    PORT: parseInt(process.env.PORT, 10) || 3100
  }
});

const app = Fastify({
  logger: {
    level: config.LOG_LEVEL,
    ...(config.NODE_ENV !== 'production' && {
      transport: {
        target: 'pino-pretty',
        options: { colorize: true, translateTime: 'HH:MM:ss Z', ignore: 'pid,hostname' }
      }
    })
  },
  ignoreTrailingSlash: true,
  bodyLimit: 1048576,
  trustProxy: true,
  ajv: {
    customOptions: { removeAdditional: 'all' }
  }
});

const corsOrigins = config.CORS_ORIGIN === '*' ? '*' : config.CORS_ORIGIN.split(',').map(o => o.trim());
app.register(cors, {
  origin: corsOrigins,
  methods: ['GET', 'POST', 'OPTIONS'],
  allowedHeaders: ['Content-Type', 'Authorization']
});

const publicDir = path.join(__dirname, '../../../frontend');
if (fs.existsSync(publicDir)) {
  try {
    app.register(require('@fastify/static'), {
      root: publicDir,
      prefix: '/',
      decorateReply: false
    });
    app.log.info({ publicDir }, '[STATIC] Sirviendo archivos estaticos');
  } catch (e) {
    app.log.warn({ err: e }, '[STATIC] No se pudo registrar @fastify/static');
  }
} else {
  app.log.warn({ publicDir }, '[STATIC] No se encontro carpeta frontend');
}

app.setErrorHandler((error, request, reply) => {
  request.log.error({ err: error, url: request.url }, error.message);
  const statusCode = error.statusCode || 500;
  const response = { error: error.message || 'Error interno del servidor', statusCode };
  if (config.NODE_ENV === 'development' && error.stack) {
    response.detail = error.stack;
  }
  reply.status(statusCode).send(response);
});

app.get('/health', async (request, reply) => {
  return reply.send({
    status: 'ok',
    timestamp: new Date().toISOString(),
    uptime: process.uptime(),
    model: config.OLLAMA_MODEL,
    ollama: config.OLLAMA_URL,
    environment: config.NODE_ENV
  });
});

app.post('/api/chat', {
  handlerTimeout: 30000,
  schema: {
    body: {
      type: 'object',
      required: ['message'],
      properties: {
        message: { type: 'string', minLength: 1, maxLength: 10000 }
      },
      additionalProperties: false
    }
  }
}, async (request, reply) => {
  const start = Date.now();
  const { message } = request.body;
  request.log.info({ messageLength: message.length }, '[CHAT] Mensaje recibido');

  try {
    const ollamaResponse = await fetch(`${config.OLLAMA_URL}/api/generate`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        model: config.OLLAMA_MODEL,
        prompt: message,
        stream: false,
        options: { temperature: 0.2, num_predict: 220, top_k: 40, top_p: 0.9 }
      })
    });

    if (!ollamaResponse.ok) {
      const errorText = await ollamaResponse.text();
      request.log.error({ status: ollamaResponse.status, errorText }, '[CHAT] Error en Ollama');
      const error = new Error(`Ollama error: ${ollamaResponse.status} - ${errorText}`);
      error.statusCode = ollamaResponse.status >= 500 ? 503 : 400;
      throw error;
    }

    const data = await ollamaResponse.json();
    const elapsed = Date.now() - start;
    request.log.info({ elapsedMs: elapsed }, '[CHAT] Respuesta generada');
    return reply.send({
      response: data.response,
      meta: { model: config.OLLAMA_MODEL, elapsed_ms: elapsed }
    });

  } catch (error) {
    if (error.code === 'UND_ERR_ABORTED' || error.name === 'AbortError') {
      error.statusCode = 504;
      error.message = 'Tiempo de espera agotado (Ollama no responde)';
    } else if (error.message?.includes('ECONNREFUSED')) {
      error.statusCode = 503;
      error.message = 'Ollama no esta disponible. Asegurate de que este ejecutandose.';
    }
    throw error;
  }
});

app.get('/', async (request, reply) => {
  if (!fs.existsSync(publicDir)) {
    return reply.send({
      name: 'Runeforge API',
      version: '2.0.0',
      endpoints: {
        chat: { method: 'POST', path: '/api/chat' },
        health: { method: 'GET', path: '/health' }
      }
    });
  }
});



// === RUTA SEGURA Y FINAL PARA FORGE Y SUS ARCHIVOS ===
const forgeDir = path.join(__dirname, '../public/forge');
app.get(['/forge', '/forge/'], (req, reply) => {
  const indexPath = path.join(forgeDir, 'index.html');
  if (fs.existsSync(indexPath)) {
    try {
      const content = fs.readFileSync(indexPath, 'utf-8');
      reply.type('text/html').send(content);
    } catch (e) {
      req.log.error({ err: e }, '[FORGE] Error interno leyendo index.html');
      reply.status(500).send({ error: 'Error interno leyendo index.html' });
    }
  } else {
    reply.status(404).send({ error: 'index.html no encontrado' });
  }
});
app.get('/forge/*', (req, reply) => {
  const filePath = path.join(forgeDir, req.params['*']);
  if (fs.existsSync(filePath)) {
    try {
      const content = fs.readFileSync(filePath, 'utf-8');
      let type = 'text/plain';
      if (filePath.endsWith('.html')) type = 'text/html';
      else if (filePath.endsWith('.css')) type = 'text/css';
      else if (filePath.endsWith('.js')) type = 'application/javascript';
      reply.type(type).send(content);
    } catch (e) {
      req.log.error({ err: e }, '[FORGE] Error interno leyendo archivo');
      reply.status(500).send({ error: 'Error interno leyendo archivo' });
    }
  } else {
    reply.status(404).send({ error: 'Archivo no encontrado' });
  }
});
// === FIN RUTA ===
app.setNotFoundHandler((request, reply) => {
  reply.status(404).send({
    error: 'Not Found',
    message: `Ruta ${request.method}:${request.url} no encontrada`,
    statusCode: 404
  });
});

const start = async () => {
  try {
    await app.listen({ port: config.PORT, host: config.HOST });
    app.log.info({
      address: `http://${config.HOST}:${config.PORT}`,
      ollama: config.OLLAMA_URL,
      model: config.OLLAMA_MODEL,
      env: config.NODE_ENV
    }, '[RUNEFORGE-CORE] SOBERANIA ACTIVA');
  } catch (err) {
    app.log.fatal({ err }, 'Error al iniciar el servidor');
    process.exit(1);
  }
};

start();