<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Runeforge Core - Mission Control v2.0</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- Chosen Palette: Runeforge Cyberpunk (Deep Space #05010B, Neon Green #39FF14, Electric Purple #BD00FF) -->
    <!-- Application Structure Plan: 
        1. Real-Time Telemetry Header: Immediate feedback on system health and node status.
        2. Dynamic Dashboard Layout: A grid-based information architecture that categorizes hardware, models, and network metrics.
        3. Tactical Navigation: Sidebar-driven navigation to explore specific sub-reports (Hardware, LLM Matrix, Network, Diagnostics).
        4. Interactive Components: 
           - VRAM usage doughnut with hover states.
           - Model comparison radar for technical benchmarking.
           - Network path toggle to visualize Local vs. VPN routing.
        5. Justification: This structure prioritizes "Status at a Glance" while allowing deep dives into technical diagnostics (like the CLI prompt bug fix) via interactive tabs, avoiding the scrolling fatigue of the original report.
    -->
    <!-- Visualization & Content Choices:
        - Hardware Composition -> Goal: Composition -> Doughnut (Chart.js) -> Visualize GPU/RAM allocation.
        - Model Benchmarking -> Goal: Compare -> Radar (Chart.js) -> Show performance trade-offs between Qwen and Gemma.
        - Response Latency -> Goal: Change -> Line (Chart.js) -> Project performance over token lengths.
        - Diagnostics -> Goal: Organize -> Interactive Content Cards -> Structured breakdown of the Ollama bug fix.
        - CONFIRMATION: NO SVG graphics used. NO Mermaid JS used.
    -->
    <style>
        @import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@300;500;800&display=swap');
        
        :root {
            --bg-deep: #05010B;
            --bg-card: #0D0211;
            --neon-green: #39FF14;
            --neon-purple: #BD00FF;
            --cyber-blue: #00F0FF;
        }

        body {
            background-color: var(--bg-deep);
            color: #E2D6EE;
            font-family: 'JetBrains Mono', monospace;
            overflow-x: hidden;
        }

        .neon-border-green { border: 1px solid var(--neon-green); box-shadow: 0 0 10px rgba(57, 255, 20, 0.2); }
        .neon-border-purple { border: 1px solid var(--neon-purple); box-shadow: 0 0 10px rgba(189, 0, 255, 0.2); }
        
        .chart-container {
            position: relative;
            width: 100%;
            max-width: 550px;
            margin-left: auto;
            margin-right: auto;
            height: 280px;
            max-height: 350px;
        }

        .tab-active {
            background: linear-gradient(to right, rgba(189, 0, 255, 0.2), transparent);
            border-left: 4px solid var(--neon-purple);
            color: white;
        }

        .status-pulse {
            animation: pulse-green 2s infinite;
        }

        @keyframes pulse-green {
            0% { box-shadow: 0 0 0 0 rgba(57, 255, 20, 0.7); }
            70% { box-shadow: 0 0 0 8px rgba(57, 255, 20, 0); }
            100% { box-shadow: 0 0 0 0 rgba(57, 255, 20, 0); }
        }

        .custom-scrollbar::-webkit-scrollbar { width: 4px; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: var(--neon-purple); }
    </style>
</head>
<body class="h-screen flex flex-col md:flex-row overflow-hidden">

    <!-- SIDE NAVIGATION -->
    <nav class="w-full md:w-64 bg-black border-r border-purple-900/40 flex flex-col z-50">
        <div class="p-6">
            <h1 class="text-xl font-extrabold tracking-tighter text-white">RUNEFORGE<span class="text-purple-500">_V2</span></h1>
            <p class="text-[10px] text-green-400 mt-1 uppercase tracking-widest">Inference Center</p>
        </div>
        
        <div class="flex-1 flex flex-col gap-1 px-2">
            <button onclick="switchTab('overview')" id="btn-overview" class="tab-active text-left p-4 text-xs font-bold uppercase transition-all duration-300">📊 Panel General</button>
            <button onclick="switchTab('models')" id="btn-models" class="text-left p-4 text-xs font-bold uppercase text-gray-500 hover:text-white transition-all">🧠 Matriz de IA</button>
            <button onclick="switchTab('network')" id="btn-network" class="text-left p-4 text-xs font-bold uppercase text-gray-500 hover:text-white transition-all">🌐 Red & Enlaces</button>
            <button onclick="switchTab('diagnostics')" id="btn-diagnostics" class="text-left p-4 text-xs font-bold uppercase text-gray-500 hover:text-white transition-all">🛠️ Diagnóstico</button>
        </div>

        <div class="p-4 bg-purple-900/10 border-t border-purple-900/30">
            <div class="flex items-center gap-2 mb-2">
                <div class="w-2 h-2 rounded-full bg-green-500 status-pulse"></div>
                <span class="text-[9px] uppercase font-bold text-gray-400">Node: Local-Host</span>
            </div>
            <div class="text-[10px] text-gray-500 font-mono">Uptime: 14h 22m</div>
        </div>
    </nav>

    <!-- MAIN CONTENT AREA -->
    <main class="flex-1 flex flex-col overflow-hidden relative">
        
        <!-- TOP TELEMETRY BAR -->
        <header class="h-16 bg-[#0D0211] border-b border-purple-900/20 flex items-center justify-between px-6 shrink-0">
            <div class="flex gap-8">
                <div class="flex flex-col">
                    <span class="text-[9px] text-gray-500 uppercase">GPU Temp</span>
                    <span class="text-sm font-bold text-green-400">54°C</span>
                </div>
                <div class="flex flex-col">
                    <span class="text-[9px] text-gray-500 uppercase">VRAM Load</span>
                    <span class="text-sm font-bold text-purple-400">26%</span>
                </div>
                <div class="flex flex-col">
                    <span class="text-[9px] text-gray-500 uppercase">Latency</span>
                    <span class="text-sm font-bold text-cyan-400">1.49s</span>
                </div>
            </div>
            <div class="hidden md:flex items-center gap-4">
                <span class="text-[10px] bg-green-500/10 text-green-400 px-3 py-1 rounded-full border border-green-500/20">Admin Session: CINER</span>
            </div>
        </header>

        <!-- CONTENT SCROLL CONTAINER -->
        <div id="scroll-container" class="flex-1 overflow-y-auto p-6 custom-scrollbar bg-[#05010B]">
            
            <!-- SECTION: OVERVIEW (DEFAULT) -->
            <section id="tab-overview" class="tab-content space-y-6">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="bg-[#0D0211] p-6 rounded-2xl border border-purple-900/30">
                        <h3 class="text-sm font-bold text-gray-400 mb-6 uppercase flex items-center gap-2">
                            <span>📀</span> Composición de Hardware
                        </h3>
                        <div class="chart-container">
                            <canvas id="hardwareChart"></canvas>
                        </div>
                    </div>
                    
                    <div class="flex flex-col gap-6">
                        <div class="bg-[#0D0211] p-5 rounded-2xl border border-green-900/30 flex justify-between items-center">
                            <div>
                                <h4 class="text-xs font-bold text-green-400 uppercase">Backend Status</h4>
                                <p class="text-[10px] text-gray-500 mt-1">Fastify Listening @ 0.0.0.0:3100</p>
                            </div>
                            <span class="px-3 py-1 bg-green-500/20 text-green-400 rounded text-[10px] font-bold">ONLINE</span>
                        </div>
                        <div class="bg-[#0D0211] p-5 rounded-2xl border border-purple-900/30 flex justify-between items-center">
                            <div>
                                <h4 class="text-xs font-bold text-purple-400 uppercase">Ollama API</h4>
                                <p class="text-[10px] text-gray-500 mt-1">REST Endpoint Stable</p>
                            </div>
                            <span class="px-3 py-1 bg-purple-500/20 text-purple-400 rounded text-[10px] font-bold">STABLE</span>
                        </div>
                        <div class="bg-[#0D0211] p-6 rounded-2xl border border-white/5 flex-1">
                            <h4 class="text-[11px] font-bold text-gray-400 uppercase mb-3">Host Info</h4>
                            <div class="space-y-2 font-mono text-[11px]">
                                <div class="flex justify-between border-b border-white/5 pb-1"><span class="text-gray-600">Machine</span> <span class="text-gray-300">desktop-ndfe0b0</span></div>
                                <div class="flex justify-between border-b border-white/5 pb-1"><span class="text-gray-600">GPU</span> <span class="text-gray-300">GTX 1660 SUPER (6GB)</span></div>
                                <div class="flex justify-between border-b border-white/5 pb-1"><span class="text-gray-600">CPU</span> <span class="text-gray-300">Ryzen 3 3200G</span></div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- SECTION: MODELS -->
            <section id="tab-models" class="tab-content hidden space-y-6">
                <div class="bg-[#0D0211] p-8 rounded-2xl border border-purple-900/20">
                    <div class="flex flex-col md:flex-row gap-12 items-center">
                        <div class="flex-1">
                            <h3 class="text-2xl font-bold text-white mb-4">Matriz de Inferencia LLM</h3>
                            <p class="text-xs text-gray-400 mb-6 leading-relaxed">
                                Comparativa táctica entre los modelos cargados en la GTX 1660 SUPER. Qwen 2.5 domina en tareas de código, mientras que Gemma 2 ofrece mayor riqueza conversacional.
                            </p>
                            <div class="space-y-4">
                                <div class="p-4 bg-black/40 rounded-lg border-l-4 border-green-500">
                                    <h4 class="text-xs font-bold text-green-400">Qwen 2.5 (1.5B)</h4>
                                    <p class="text-[10px] text-gray-500">Ideal para PowerShell y automatización de sistema.</p>
                                </div>
                                <div class="p-4 bg-black/40 rounded-lg border-l-4 border-purple-500">
                                    <h4 class="text-xs font-bold text-purple-400">Gemma 2 (2B)</h4>
                                    <p class="text-[10px] text-gray-500">Optimizado para redacción y lógica compleja.</p>
                                </div>
                            </div>
                        </div>
                        <div class="chart-container">
                            <canvas id="modelRadar"></canvas>
                        </div>
                    </div>
                </div>
            </section>

            <!-- SECTION: NETWORK -->
            <section id="tab-network" class="tab-content hidden space-y-6">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="bg-gradient-to-br from-[#0D0211] to-[#15051C] p-6 rounded-2xl border border-cyan-900/30">
                        <h3 class="text-sm font-bold text-cyan-400 mb-6 uppercase">Enlaces de Acceso iPhone</h3>
                        <div class="space-y-4">
                            <div class="bg-black/40 p-4 rounded-xl">
                                <div class="flex justify-between mb-2">
                                    <span class="text-[10px] font-bold text-white uppercase">Wi-Fi Casa</span>
                                    <span class="text-[9px] text-green-500">LATENCIA BAJA</span>
                                </div>
                                <code class="text-xs text-gray-400">http://192.168.1.XX:3100/forge</code>
                            </div>
                            <div class="bg-black/40 p-4 rounded-xl">
                                <div class="flex justify-between mb-2">
                                    <span class="text-[10px] font-bold text-white uppercase">Tailscale VPN</span>
                                    <span class="text-[9px] text-purple-500">ACCESO REMOTO</span>
                                </div>
                                <code class="text-xs text-gray-400">http://100.111.32.10:3100/forge</code>
                            </div>
                        </div>
                    </div>
                    <div class="bg-[#0D0211] p-6 rounded-2xl border border-white/5 flex flex-col justify-center">
                        <div class="text-center p-8">
                            <div class="text-4xl mb-4">📱</div>
                            <h4 class="text-white font-bold mb-2">iPhone Status: Active</h4>
                            <p class="text-xs text-gray-500 leading-relaxed">El nodo móvil 'rf-iphone-nesth' se encuentra sincronizado con el backend vía PWA.</p>
                            <div class="mt-6 flex justify-center gap-2">
                                <div class="w-2 h-2 rounded-full bg-green-500"></div>
                                <div class="w-2 h-2 rounded-full bg-green-500"></div>
                                <div class="w-2 h-2 rounded-full bg-gray-700"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- SECTION: DIAGNOSTICS -->
            <section id="tab-diagnostics" class="tab-content hidden space-y-6">
                <div class="bg-red-950/10 border border-red-500/20 p-6 rounded-2xl">
                    <h3 class="text-sm font-bold text-red-400 mb-4 uppercase">Fix: Prompt Infinito (>>>)</h3>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        <div class="bg-black/40 p-4 rounded-lg">
                            <span class="text-[10px] font-bold text-gray-500">SÍNTOMA</span>
                            <p class="text-xs text-gray-300 mt-2">Cascada de símbolos en terminal por saltos de línea vacíos en stdin.</p>
                        </div>
                        <div class="bg-black/40 p-4 rounded-lg">
                            <span class="text-[10px] font-bold text-gray-500">CAUSA</span>
                            <p class="text-xs text-gray-300 mt-2">Uso de Ollama CLI interactivo en lugar de la API HTTP nativa.</p>
                        </div>
                        <div class="bg-black/40 p-4 rounded-lg">
                            <span class="text-[10px] font-bold text-green-400">SOLUCIÓN</span>
                            <p class="text-xs text-gray-300 mt-2">Migración a endpoint /api/chat con payload JSON sanitizado.</p>
                        </div>
                    </div>
                </div>
                <div class="bg-[#0D0211] p-6 rounded-2xl border border-white/5">
                    <h4 class="text-xs font-bold text-gray-400 uppercase mb-4">Pipeline de Respuesta</h4>
                    <div class="flex flex-col md:flex-row justify-between gap-4 items-center font-mono text-[10px]">
                        <div class="px-4 py-2 bg-purple-900/30 rounded border border-purple-500/30">USER PROMPT</div>
                        <span class="text-gray-700">→</span>
                        <div class="px-4 py-2 bg-blue-900/30 rounded border border-blue-500/30">FASTIFY PROXY</div>
                        <span class="text-gray-700">→</span>
                        <div class="px-4 py-2 bg-green-900/30 rounded border border-green-500/30">OLLAMA HTTP</div>
                        <span class="text-gray-700">→</span>
                        <div class="px-4 py-2 bg-red-900/30 rounded border border-red-500/30">GTX INFERENCE</div>
                    </div>
                </div>
            </section>

        </div>

        <!-- FOOTER / CONTEXT -->
        <footer class="h-12 bg-black border-t border-white/5 flex items-center justify-between px-6 shrink-0">
            <span class="text-[9px] text-gray-600 uppercase tracking-widest">© 2026 Runeforge Ecosystem | CINER Engineering</span>
            <span class="text-[9px] text-gray-600 font-mono italic">Local-First Digital Sovereignty</span>
        </footer>
    </main>

    <script>
        // --- Tab Management ---
        function switchTab(tabName) {
            // Hide all
            document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
            document.querySelectorAll('nav button').forEach(el => {
                el.classList.remove('tab-active');
                el.classList.add('text-gray-500');
            });

            // Show selected
            document.getElementById(`tab-${tabName}`).classList.remove('hidden');
            document.getElementById(`btn-${tabName}`).classList.add('tab-active');
            document.getElementById(`btn-${tabName}`).classList.remove('text-gray-500');
        }

        // --- Charts Implementation ---
        
        // 1. Hardware Usage (Doughnut)
        const hwCtx = document.getElementById('hardwareChart').getContext('2d');
        new Chart(hwCtx, {
            type: 'doughnut',
            data: {
                labels: ['VRAM Usada', 'VRAM Libre', 'RAM Sistema', 'RAM Libre'],
                datasets: [{
                    data: [1.6, 4.4, 5.2, 10.8],
                    backgroundColor: ['#BD00FF', '#15051C', '#39FF14', '#15051C'],
                    borderColor: '#0D0211',
                    borderWidth: 3
                }]
            },
            options: {
                maintainAspectRatio: false,
                cutout: '75%',
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: { color: '#A090B0', font: { size: 10, family: 'JetBrains Mono' }, padding: 20 }
                    }
                }
            }
        });

        // 2. Model Radar Comparison
        const radarCtx = document.getElementById('modelRadar').getContext('2d');
        new Chart(radarCtx, {
            type: 'radar',
            data: {
                labels: ['Lógica', 'Código', 'Velocidad', 'Contexto', 'Precisión'],
                datasets: [
                    {
                        label: 'Qwen 2.5 (1.5B)',
                        data: [85, 95, 98, 70, 90],
                        borderColor: '#39FF14',
                        backgroundColor: 'rgba(57, 255, 20, 0.1)',
                        pointBackgroundColor: '#39FF14'
                    },
                    {
                        label: 'Gemma 2 (2B)',
                        data: [92, 70, 85, 85, 95],
                        borderColor: '#BD00FF',
                        backgroundColor: 'rgba(189, 0, 255, 0.1)',
                        pointBackgroundColor: '#BD00FF'
                    }
                ]
            },
            options: {
                maintainAspectRatio: false,
                scales: {
                    r: {
                        grid: { color: '#250A35' },
                        angleLines: { color: '#250A35' },
                        pointLabels: { color: '#A090B0', font: { size: 10 } },
                        ticks: { display: false }
                    }
                },
                plugins: {
                    legend: { labels: { color: '#E2D6EE', font: { size: 10 } } }
                }
            }
        });

        // Handle Responsiveness on Tab Switch
        window.addEventListener('resize', () => {
            // Re-render logic if needed
        });
    </script>
</body>
</html>