const forgePath = path.join(__dirname, '../../../../public/forge/index.html');

app.get('/', (req, reply) => {
  if (fs.existsSync(forgePath)) {
    const content = fs.readFileSync(forgePath, 'utf-8');
    reply.type('text/html').send(content);
  } else {
    // SI NO ENCUENTRA EL FORGE, REDIRIGE A LA PWA PARA NO DAR ERROR FEO
    reply.redirect('/pwa');
  }
});

app.get('/forge', (req, reply) => {
  if (fs.existsSync(forgePath)) {
    const content = fs.readFileSync(forgePath, 'utf-8');
    reply.type('text/html').send(content);
  } else {
    reply.status(404).send({ error: 'index.html no encontrado en public/forge' });
  }
});

app.get('/forge/*', (req, reply) => {
  const filePath = path.join(__dirname, '../../../../public/forge', req.params['*']);
  if (fs.existsSync(filePath)) {
    const content = fs.readFileSync(filePath, 'utf-8');
    let type = 'text/plain';
    if (filePath.endsWith('.html')) type = 'text/html';
    else if (filePath.endsWith('.css')) type = 'text/css';
    else if (filePath.endsWith('.js')) type = 'application/javascript';
    reply.type(type).send(content);
  } else {
    reply.status(404).send({ error: 'Archivo no encontrado' });
  }
});
