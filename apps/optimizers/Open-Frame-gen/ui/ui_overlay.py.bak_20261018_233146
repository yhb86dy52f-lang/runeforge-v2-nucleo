class GLVideoWidget(QOpenGLWidget):
    def __init__(self, parent=None):
        super().__init__(parent)
        self._frame = None
        self._tex = None
        self._tex_res = (0, 0)
        self.setAttribute(Qt.WA_TransparentForMouseEvents)

    def initializeGL(self):
        glEnable(GL_TEXTURE_2D)
        glClearColor(0.0, 0.0, 0.0, 0.0)
        glEnable(GL_BLEND)
        glBlendFunc(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA)
        self._tex = glGenTextures(1)
        glBindTexture(GL_TEXTURE_2D, self._tex)
        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR)
        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR)

    def resizeGL(self, w, h):
        glViewport(0, 0, w, h)
        glMatrixMode(GL_PROJECTION)
        glLoadIdentity()
        glOrtho(0, w, h, 0, -1, 1)
        glMatrixMode(GL_MODELVIEW)
        glLoadIdentity()

    def paintGL(self):
        glClear(GL_COLOR_BUFFER_BIT)
        if self._frame is not None:
            h, w = self._frame.shape[:2]
            glBindTexture(GL_TEXTURE_2D, self._tex)
            if (w, h) != self._tex_res:
                self._tex_res = (w, h)
                glTexImage2D(GL_TEXTURE_2D, 0, GL_RGB, w, h, 0, GL_RGB, GL_UNSIGNED_BYTE, None)
            glTexSubImage2D(GL_TEXTURE_2D, 0, 0, 0, w, h, GL_RGB, GL_UNSIGNED_BYTE, self._frame)

            W, H = self.width(), self.height()
            glBegin(GL_QUADS)
            glTexCoord2f(0, 0); glVertex2f(0, H)
            glTexCoord2f(1, 0); glVertex2f(W, H)
            glTexCoord2f(1, 1); glVertex2f(W, 0)
            glTexCoord2f(0, 1); glVertex2f(0, 0)
            glEnd()

    def update_frame(self, frame):
        self._frame = frame
        self.repaint() # Repaint immediately for lowest latency

# ═══════════════════════════════════════════════════════════════════════════
#  PIPELINE WORKER
# ═══════════════════════════════════════════════════════════════════════════
class PipelineWorker(QThread):
    frame_ready = pyqtSignal(object)
    fps_output  = pyqtSignal(float)
    fps_game    = pyqtSignal(float)
    log_msg     = pyqtSignal(str)

    def __init__(self, target_hwnd, bypass_ai=False):
        super().__init__()
        self.target_hwnd = target_hwnd
        self.bypass_ai = bypass_ai
        self._running = True

    def stop(self): self._running = False

    def run(self):
        import dxcam
        self.log_msg.emit("⚙  Initialising DXCam...")
        region = _window_region(self.target_hwnd)
        try:
            del cam
        except:
            pass
        cam = dxcam.create(region=None, output_color="BGRA", max_buffer_len=2)
        cam.start(video_mode=True)

        test = None
        for _ in range(50):
            test = cam.get_latest_frame()
            if test is not None: break
            time.sleep(0.01)
        if test is None:
            self.log_msg.emit("❌ DXCam Timeout"); cam.stop(); return

        H, W = test.shape[:2]
        ai_H, ai_W = int(H * AI_SCALE), int(W * AI_SCALE)
        ai_H = (ai_H // 32) * 32
        ai_W = (ai_W // 32) * 32

        engine = None
        if not self.bypass_ai:
            self.log_msg.emit("⚙  Loading AI Engine...")
            try:
                engine = NanoEngine(MODEL_PATH, input_shape=(ai_H, ai_W))
            except Exception as e:
                self.log_msg.emit(f"❌ Engine Error: {e}")
                cam.stop(); return

        device = torch.device("cuda")
        dtype  = torch.float16

        frame_times = collections.deque(maxlen=60)
        out_times = collections.deque(maxlen=60)
        prev_t = time.perf_counter()
        last_out_t = time.perf_counter()

        print(f"🚀 Pipeline Live | AI={not self.bypass_ai} | {ai_W}x{ai_H}")
        self.log_msg.emit("🚀 Running...")

        prev_gpu = None

        while self._running:
            raw = cam.get_latest_frame()
            if raw is None: continue

            now = time.perf_counter()
            frame_times.append(now - prev_t)
            prev_t = now

            with torch.inference_mode():
                # 1. Fast Upload
                t_raw = torch.from_numpy(raw).to(device, non_blocking=True)
                # 2. BGRA -> RGB & Normalize
                t_rgb = t_raw[..., [2, 1, 0]].permute(2, 0, 1).to(dtype).div_(255.0)

                # 3. Downsample to AI Internal Res
                curr_gpu = torch.nn.functional.interpolate(t_rgb.unsqueeze(0), size=(ai_H, ai_W), mode='bilinear', align_corners=False).squeeze(0)

                if self.bypass_ai:
                    # Pass-through Mode
                    out_rgb = (curr_gpu.permute(1, 2, 0) * 255).byte().cpu().numpy()
                    self.frame_ready.emit(out_rgb)

                    o_now = time.perf_counter()
                    out_times.append(o_now - last_out_t)
                    last_out_t = o_now
                else:
                    # AI Interpolation Mode
                    if prev_gpu is not None:
                        # 4. Infer Mid Frame
                        x = torch.cat([prev_gpu.unsqueeze(0), curr_gpu.unsqueeze(0)], dim=1)
                        mid_gpu = engine.infer_tensor(x)

                        # 5. Emit Mid then Real (Doubling FPS)
                        mid_np = mid_gpu.permute(1, 2, 0).cpu().numpy()
                        self.frame_ready.emit(mid_np)
                        o_now = time.perf_counter()
                        out_times.append(o_now - last_out_t)
                        last_out_t = o_now

                        real_np = (prev_gpu.permute(1, 2, 0) * 255).byte().cpu().numpy()
                        self.frame_ready.emit(real_np)
                        o_now = time.perf_counter()
                        out_times.append(o_now - last_out_t)
                        last_out_t = o_now

                    prev_gpu = curr_gpu

            if len(frame_times) >= 10: self.fps_game.emit(1.0 / (sum(frame_times)/len(frame_times)))
            if len(out_times) >= 10: self.fps_output.emit(1.0 / (sum(out_times)/len(out_times)))

        cam.stop()

