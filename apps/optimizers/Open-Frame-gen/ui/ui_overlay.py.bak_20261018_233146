class FPSCounter(QWidget):
    def __init__(self):
        super().__init__()
        self.setWindowFlags(Qt.FramelessWindowHint | Qt.WindowStaysOnTopHint | Qt.Tool | Qt.WindowTransparentForInput)
        self.setAttribute(Qt.WA_TranslucentBackground)
        self.setFixedSize(180, 80)
        self.output_fps, self.game_fps = 0.0, 0.0
        self._visible = False
        QTimer(self, timeout=self.update).start(200)

    def paintEvent(self, _):
        if not self._visible: return
        p = QPainter(self); p.setRenderHint(QPainter.Antialiasing)
        p.setBrush(QColor(10, 11, 15, 230)); p.setPen(QColor(30, 33, 48))
        p.drawRoundedRect(0, 0, 180, 80, 8, 8)
        p.setPen(QColor(0, 245, 196)); p.setFont(QFont("Consolas", 10, QFont.Bold))
        p.drawText(10, 30, f"OUT:  {self.output_fps:.0f} FPS")
        p.setPen(QColor(200, 207, 224))
        p.drawText(10, 55, f"GAME: {self.game_fps:.0f} FPS")

class ControlPanel(QWidget):
    def __init__(self, overlay, fps_counter):
        super().__init__()
        self.overlay, self.fps_counter = overlay, fps_counter
        self.worker = None
        self.setWindowTitle("NANO · PRO PIPELINE")
        self.setWindowFlags(Qt.WindowStaysOnTopHint)
        self.setStyleSheet(PANEL_STYLE)
        self.setFixedSize(320, 420)

        v = QVBoxLayout(self); card = QFrame(); card.setObjectName("card"); v.addWidget(card)
        l = QVBoxLayout(card)

        title = QLabel("NANO AI PRO"); title.setObjectName("title"); l.addWidget(title)

        self._lbl_fps = QLabel("OUT: —"); self._lbl_fps.setObjectName("value"); l.addWidget(self._lbl_fps)
        self._lbl_game = QLabel("GAME: —"); l.addWidget(self._lbl_game)
        self._lbl_log = QLabel("Ready."); self._lbl_log.setStyleSheet(f"color:{C_DIM}"); l.addWidget(self._lbl_log)

        l.addStretch()
        l.addWidget(QLabel("TARGET WINDOW"))
        self._win_combo = QComboBox(); l.addWidget(self._win_combo)
        self._refresh_windows()

        btn_refresh = QPushButton("REFRESH WINDOWS"); btn_refresh.clicked.connect(self._refresh_windows); l.addWidget(btn_refresh)

        self._btn = QPushButton("START AI PIPELINE"); self._btn.setStyleSheet(TOGGLE_ON); l.addWidget(self._btn)
        self._btn.clicked.connect(lambda: self._toggle(False))

        self._btn_pass = QPushButton("PASS-THROUGH TEST"); l.addWidget(self._btn_pass)
        self._btn_pass.clicked.connect(lambda: self._toggle(True))

        btn_shot = QPushButton("SAVE AI SCREENSHOT"); btn_shot.clicked.connect(self._take_screenshot); l.addWidget(btn_shot)

    def _refresh_windows(self):
        self._win_combo.clear(); self._win_combo.addItem("Fullscreen / Monitor 0", None)
        for h, t in _enum_windows(): self._win_combo.addItem(t, h)

    def _take_screenshot(self):
        if self.overlay.gl_widget._frame is not None:
            f = self.overlay.gl_widget._frame
            h, w, c = f.shape
            img = QImage(f.data, w, h, w*c, QImage.Format_RGB888)
            fname = f"ai_shot_{int(time.time())}.png"
            img.save(fname)
            self._lbl_log.setText(f"Saved: {fname}")

    def _toggle(self, pass_through):
        if not self.worker:
            self._btn.setText("STOP PIPELINE"); self._btn.setStyleSheet(TOGGLE_OFF)
            self.fps_counter._visible = True

            # MANDATORY: Hide overlay from system capture to prevent feedback loop
            _set_capture_visibility(self.overlay, False)
            _set_capture_visibility(self.fps_counter, False)
            _set_capture_visibility(self, False)

            self.overlay.showFullScreen()

            self.worker = PipelineWorker(self._win_combo.currentData(), bypass_ai=pass_through)
            self.worker.frame_ready.connect(self.overlay.gl_widget.update_frame)
            self.worker.fps_output.connect(lambda v: (self._lbl_fps.setText(f"OUT: {v:.0f}"), setattr(self.fps_counter, 'output_fps', v)))
            self.worker.fps_game.connect(lambda v: (self._lbl_game.setText(f"GAME: {v:.0f}"), setattr(self.fps_counter, 'game_fps', v)))
            self.worker.log_msg.connect(self._lbl_log.setText)
            self.worker.start()
        else:
            self._btn.setText("START AI PIPELINE"); self._btn.setStyleSheet(TOGGLE_ON)
            self.fps_counter._visible = False
            self.overlay.hide()
            # Restore visibility when stopped
            _set_capture_visibility(self.overlay, True)
            _set_capture_visibility(self.fps_counter, True)
            _set_capture_visibility(self, True)
            self.worker.stop(); self.worker.wait(); self.worker = None

