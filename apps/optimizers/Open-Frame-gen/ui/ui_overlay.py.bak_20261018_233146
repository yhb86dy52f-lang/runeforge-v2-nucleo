def _enum_windows() -> list:
    results = []
    def _cb(hwnd, _):
        if not win32gui.IsWindowVisible(hwnd): return
        title = win32gui.GetWindowText(hwnd)
        if not title or len(title) < 2: return
        if title in {"Program Manager", "NANO AI OVERLAY", "NANO · PRO PIPELINE"}: return
        results.append((hwnd, title))
    win32gui.EnumWindows(_cb, None)
    return results

def _window_region(hwnd) -> tuple | None:
    try:
        if hwnd is None or win32gui.IsIconic(hwnd): return None
        l, t, r, b = win32gui.GetWindowRect(hwnd)
        return (l, t, r, b)
    except: return None

def _set_capture_visibility(window_obj, visible: bool):
    """
    Sets the window display affinity.
    WDA_EXCLUDEFROMCAPTURE (2) is mandatory to prevent the AI from capturing itself.
    """
    try:
        wid = window_obj.effectiveWinId()
        if wid is None: return
        hwnd = int(wid)
        # Apply to the root window handle to ensure all children are hidden too
        root_hwnd = win32gui.GetAncestor(hwnd, win32con.GA_ROOT)
        flag = 0 if visible else 2
        ctypes.windll.user32.SetWindowDisplayAffinity(root_hwnd, flag)
    except Exception as e:
        print(f"Affinity Error: {e}")

