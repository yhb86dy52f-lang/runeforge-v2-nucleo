{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ScannerPRO Cyber Visualizer v11",
  "version": "11.0.0",
  "identifier": "com.runeforge.scannerpro",
  "build": {
    "frontendDist": "../src",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "RUNEFORGE SCANNER-PRO v11 - 192.168.100.3",
        "width": 1366,
        "height": 850,
        "minWidth": 1200,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "dangerousDisableAssetCspModification": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}