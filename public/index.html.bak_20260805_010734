<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Runeforge Dashboard</title>
    <style>
        body { margin: 0; padding: 0; background: #0D0211; color: #E2D6EE; font-family: 'Courier New', monospace; overflow: hidden; height: 100vh; display: flex; flex-direction: column; }
        #nav { display: flex; gap: 5px; padding: 10px 15px; background: #15051C; border-bottom: 1px solid #39FF14; flex-wrap: wrap; flex-shrink: 0; }
        #nav button { background: transparent; border: 1px solid #BD00FF; color: #E2D6EE; padding: 8px 12px; border-radius: 6px; cursor: pointer; font-family: inherit; font-size: 12px; transition: all 0.2s; white-space: nowrap; }
        #nav button:hover { border-color: #39FF14; color: #39FF14; }
        #nav button.active { background: #39FF14; color: #0D0211; border-color: #39FF14; font-weight: bold; }
        #iframe-container { flex: 1; overflow: hidden; background: #0D0211; }
        #iframe-container iframe { width: 100%; height: 100%; border: none; }
    </style>
</head>
<body>
    <div id="nav">
        <button class="active" onclick="switchPage('forge')">Bitácora PRO</button>
        <button onclick="switchPage('mission')">Mission Control</button>
        <button onclick="switchPage('control')">Control IA</button>
        <button onclick="switchPage('pwa')">PWA Offline</button>
        <button onclick="switchPage('acceso')">Acceso iPhone</button>
        <button onclick="switchPage('deepseek')">DeepSeek</button>
        <button onclick="switchPage('infograma')">Infografía</button>
        <button onclick="switchPage('roadmap')">Roadmap</button>
        <button onclick="switchPage('chat')">Chat Simple</button>
        <button onclick="switchPage('docs')">📄 Documentación</button>
    </div>
    <div id="iframe-container">
        <iframe id="mainFrame" src="/pages/forge.html"></iframe>
    </div>
    <script>
        function switchPage(page) {
            document.querySelectorAll('#nav button').forEach(b => b.classList.remove('active'));
            const activeBtn = document.querySelector(`#nav button[onclick*="'${page}'"]`);
            if(activeBtn) activeBtn.classList.add('active');
            if (page === 'docs') {
                document.getElementById('mainFrame').src = '/docs/';
            } else {
                document.getElementById('mainFrame').src = '/pages/' + page + '.html';
            }
        }
    </script>
</body>
</html>
