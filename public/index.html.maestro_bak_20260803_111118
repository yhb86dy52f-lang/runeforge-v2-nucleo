<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Runeforge Dashboard</title>
    <style>
        /* Estilos globales del Dashboard Maestro */
        body {
            margin: 0;
            padding: 0;
            background: #0D0211;
            color: #E2D6EE;
            font-family: 'Courier New', monospace;
            overflow: hidden;
            height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* Barra de navegación superior (Pestañas de Herramientas) */
        #nav {
            display: flex;
            gap: 5px;
            padding: 10px 15px;
            background: #15051C;
            border-bottom: 1px solid #39FF14;
            flex-wrap: wrap;
            flex-shrink: 0;
        }
        #nav button {
            background: transparent;
            border: 1px solid #BD00FF;
            color: #E2D6EE;
            padding: 8px 12px;
            border-radius: 6px;
            cursor: pointer;
            font-family: inherit;
            font-size: 12px;
            transition: all 0.2s;
            white-space: nowrap;
        }
        #nav button:hover {
            border-color: #39FF14;
            color: #39FF14;
        }
        #nav button.active {
            background: #39FF14;
            color: #0D0211;
            border-color: #39FF14;
            font-weight: bold;
        }

        /* Contenedor del iframe */
        #iframe-container {
            flex: 1;
            overflow: hidden;
            position: relative;
            background: #0D0211;
        }
        #iframe-container iframe {
            width: 100%;
            height: 100%;
            border: none;
            display: block;
        }
    </style>
</head>
<body>

    <!-- Barra de pestañas para las 9 herramientas -->
    <div id="nav">
        <button class="active" data-page="forge">Bitácora PRO</button>
        <button data-page="mission">Mission Control</button>
        <button data-page="control">Control IA</button>
        <button data-page="pwa">PWA Offline</button>
        <button data-page="acceso">Acceso iPhone</button>
        <button data-page="deepseek">DeepSeek</button>
        <button data-page="infograma">Infografía</button>
        <button data-page="roadmap">Roadmap</button>
        <button data-page="chat">Chat Simple</button>
    </div>

    <!-- Área de visualización (Iframe) -->
    <div id="iframe-container">
        <iframe id="mainFrame" src="/pages/forge.html"></iframe>
    </div>

    <script>
        // Lógica para cambiar las pestañas
        const buttons = document.querySelectorAll('#nav button');
        const iframe = document.getElementById('mainFrame');

        // Cargar la última pestaña activa guardada (opcional)
        const activePage = localStorage.getItem('runeforge_active_page') || 'forge';
        setActivePage(activePage);

        buttons.forEach(btn => {
            btn.addEventListener('click', function() {
                const page = this.dataset.page;
                setActivePage(page);
                localStorage.setItem('runeforge_active_page', page);
            });
        });

        function setActivePage(page) {
            // Actualizar botones
            buttons.forEach(b => b.classList.remove('active'));
            const activeBtn = document.querySelector(#nav button[data-page=""]);
            if (activeBtn) activeBtn.classList.add('active');

            // Cargar en el iframe
            iframe.src = '/pages/' + page + '.html';
        }
    </script>
</body>
</html>
