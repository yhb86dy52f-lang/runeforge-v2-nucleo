Config cfg;

// ============ PERSISTENCIA ============
inline void configSave() {
  Preferences prefs;
  prefs.begin("runeforge", false);
  prefs.putBytes("cfg", &cfg, sizeof(cfg));
  prefs.end();
  Serial.printf("[CFG] guardado (%u bytes)\n", (unsigned)sizeof(cfg));
}

inline void configFactoryReset() {
  memset(&cfg, 0, sizeof(cfg));
  Config def;
  memcpy(&cfg, &def, sizeof(Config));
  Serial.println("[CFG] factory reset aplicado");
}

inline void configLoad() {
  Preferences prefs;
  prefs.begin("runeforge", true); // read-only
  size_t stored = prefs.getBytesLength("cfg");
  if (stored == sizeof(cfg)) {
    prefs.getBytes("cfg", &cfg, sizeof(cfg));
    Serial.println("[CFG] cargado desde NVS");
  } else {
    Serial.printf("[CFG] NVS vacío o schema cambiado (%u vs %u), usando defaults\n",
                  (unsigned)stored, (unsigned)sizeof(cfg));
    prefs.end();
    configFactoryReset();
    configSave();
    return;
  }
  prefs.end();
}

