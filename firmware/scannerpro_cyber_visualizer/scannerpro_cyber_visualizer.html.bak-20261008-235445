<body class="min-h-screen flex flex-col">

    <!-- Top Navigation Header -->
    <header class="glass-panel sticky top-0 z-50 px-6 py-3 flex items-center justify-between border-b border-cyber-border">
        <div class="flex items-center space-x-3">
            <div class="p-2 bg-cyber-500/10 rounded-lg border border-cyber-500/30">
                <i data-lucide="radar" class="w-6 h-6 text-cyber-500 animate-spin" style="animation-duration: 8s;"></i>
            </div>
            <div>
                <h1 class="text-xl font-bold tracking-wider glow-text">RUNEFORGE <span class="text-white">SCANNER-PRO v10.0</span></h1>
                <p class="text-xs text-cyber-600 font-mono">ESP32-D0WD-V3 | COM5 | MQTT 192.168.100.10:9001</p>
            </div>
        </div>

        <!-- Connection Status & Controls -->
        <div class="flex items-center space-x-4">
            <div id="mqttStatusBadge" class="flex items-center space-x-2 px-3 py-1 rounded-full text-xs font-mono bg-yellow-500/10 text-yellow-400 border border-yellow-500/30">
                <span class="w-2 h-2 rounded-full bg-yellow-400 animate-pulse"></span>
                <span id="mqttStatusText">CONECTANDO A BROKER...</span>
            </div>

            <button id="toggleGeigerBtn" onclick="toggleAudio()" class="px-3 py-1.5 rounded-lg bg-cyber-500/10 border border-cyber-500/30 text-cyber-500 hover:bg-cyber-500/20 text-xs font-mono flex items-center space-x-2 transition">
                <i data-lucide="volume-x" id="audioIcon" class="w-4 h-4"></i>
                <span id="audioLabel">AUDIO GEIGER: OFF</span>
            </button>

            <button onclick="switchTab('firmware')" class="px-3 py-1.5 rounded-lg bg-purple-500/10 border border-purple-500/30 text-purple-400 hover:bg-purple-500/20 text-xs font-mono flex items-center space-x-2 transition">
                <i data-lucide="code" class="w-4 h-4"></i>
                <span>C++ CONFIG.H</span>
            </button>
        </div>
    </header>

    <!-- Main Navigation Tabs -->
    <div class="px-6 pt-4 flex space-x-2 border-b border-cyber-border bg-cyber-bg/50">
        <button onclick="switchTab('radar')" id="tabBtn-radar" class="px-4 py-2 text-sm font-semibold border-b-2 border-cyber-500 text-cyber-500 flex items-center space-x-2 transition">
            <i data-lucide="disc" class="w-4 h-4"></i>
            <span>RADAR & SPECTROGRAM</span>
        </button>
        <button onclick="switchTab('fuel')" id="tabBtn-fuel" class="px-4 py-2 text-sm font-semibold border-b-2 border-transparent text-gray-400 hover:text-cyber-500 flex items-center space-x-2 transition">
            <i data-lucide="fuel" class="w-4 h-4"></i>
            <span>ESCORT TD-BLE FUEL SENSOR</span>
        </button>
        <button onclick="switchTab('devices')" id="tabBtn-devices" class="px-4 py-2 text-sm font-semibold border-b-2 border-transparent text-gray-400 hover:text-cyber-500 flex items-center space-x-2 transition">
            <i data-lucide="cpu" class="w-4 h-4"></i>
            <span>TAGS & SCANNER STATUS</span>
        </button>
        <button onclick="switchTab('firmware')" id="tabBtn-firmware" class="px-4 py-2 text-sm font-semibold border-b-2 border-transparent text-gray-400 hover:text-cyber-500 flex items-center space-x-2 transition">
            <i data-lucide="file-code" class="w-4 h-4"></i>
            <span>GENERADOR C++ ESP32</span>
        </button>
    </div>

    <!-- Main View Content Container -->
    <main class="flex-1 p-6 space-y-6">

        <!-- TAB 1: RADAR & ESPECTROGRAMA -->
        <section id="tab-radar" class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Radar Canvas Container -->
            <div class="lg:col-span-2 glass-panel p-4 rounded-xl flex flex-col items-center justify-center relative min-h-[480px]">
                <div class="absolute top-4 left-4 flex items-center space-x-2 text-xs font-mono text-cyber-500">
                    <span class="w-2 h-2 rounded-full bg-cyber-500 animate-ping"></span>
                    <span>POLAR RADAR 360° (RSSI -30 to -100 dBm)</span>
                </div>
                <canvas id="radarCanvas" width="500" height="450" class="max-w-full h-auto cursor-crosshair"></canvas>
            </div>

            <!-- Signal & Waterfall Panel -->
            <div class="space-y-6 flex flex-col justify-between">
                <!-- Target Lock Card -->
                <div class="glass-panel p-4 rounded-xl space-y-3">
                    <h3 class="text-xs font-bold font-mono tracking-widest text-cyber-500 uppercase flex items-center space-x-2">
                        <i data-lucide="crosshair" class="w-4 h-4"></i>
                        <span>TARGET LOCK DETECTADO</span>
                    </h3>
                    <div id="targetDetails" class="space-y-2 text-xs font-mono">
                        <div class="flex justify-between border-b border-cyber-border/50 pb-1">
                            <span class="text-gray-400">MAC / ID:</span>
                            <span id="targetMac" class="text-white font-bold">D1:6D:2A:5B:BE:07</span>
                        </div>
                        <div class="flex justify-between border-b border-cyber-border/50 pb-1">
                            <span class="text-gray-400">DISPOSITIVO:</span>
                            <span id="targetName" class="text-cyber-500">ESCORT TD-BLE (Fuel)</span>
                        </div>
                        <div class="flex justify-between border-b border-cyber-border/50 pb-1">
                            <span class="text-gray-400">RSSI POTENCIA:</span>
                            <span id="targetRssi" class="text-green-400 font-bold">-58 dBm</span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-gray-400">ÚLTIMO PAQUETE:</span>
                            <span id="targetTime" class="text-gray-300">Hace 0.4s</span>
                        </div>
                    </div>
                </div>

                <!-- Waterfall RSSI Spectrum -->
                <div class="glass-panel p-4 rounded-xl flex-1 flex flex-col justify-between min-h-[220px]">
                    <h3 class="text-xs font-bold font-mono tracking-widest text-cyber-500 uppercase flex items-center space-x-2 mb-2">
                        <i data-lucide="activity" class="w-4 h-4"></i>
