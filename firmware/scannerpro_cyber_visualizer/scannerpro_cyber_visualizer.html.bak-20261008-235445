    <!-- JavaScript Application Core -->
    <script>
        // Init Lucide Icons
        lucide.createIcons();

        // Application State
        let currentTab = 'radar';
        let audioEnabled = false;
        let audioCtx = null;
        let mqttClient = null;

        // Simulated & Live BLE Targets
        let targets = [
            { id: 'b4:0e:cf:44:fe:ba', name: 'Tile Tag', family: 'tile', rssi: -50, angle: 45, dist: 0.3 },
            { id: 'd1:6d:2a:5b:be:07', name: 'Escort TD-BLE', family: 'fuel', rssi: -58, angle: 160, dist: 0.45 },
            { id: '7a:8b:11:98:82:db', name: 'Unknown BLE', family: 'other', rssi: -65, angle: 280, dist: 0.65 }
        ];

        // Tab Switching Logic
        function switchTab(tabId) {
            currentTab = tabId;
            ['radar', 'fuel', 'devices', 'firmware'].forEach(t => {
                const tabEl = document.getElementById(`tab-${t}`);
                const btnEl = document.getElementById(`tabBtn-${t}`);
                if (t === tabId) {
                    tabEl.classList.remove('hidden');
                    btnEl.classList.add('border-cyber-500', 'text-cyber-500');
                    btnEl.classList.remove('border-transparent', 'text-gray-400');
                } else {
                    tabEl.classList.add('hidden');
                    btnEl.classList.remove('border-cyber-500', 'text-cyber-500');
                    btnEl.classList.add('border-transparent', 'text-gray-400');
                }
            });
        }

        // Web Audio API Geiger Counter Synthesizer
        function toggleAudio() {
            audioEnabled = !audioEnabled;
            const icon = document.getElementById('audioIcon');
            const label = document.getElementById('audioLabel');
            const btn = document.getElementById('toggleGeigerBtn');

            if (audioEnabled) {
                if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
                icon.setAttribute('data-lucide', 'volume-2');
                label.innerText = 'AUDIO GEIGER: ON';
                btn.classList.add('bg-cyber-500/30', 'text-white');
                scheduleGeigerClick();
            } else {
                icon.setAttribute('data-lucide', 'volume-x');
                label.innerText = 'AUDIO GEIGER: OFF';
                btn.classList.remove('bg-cyber-500/30', 'text-white');
            }
            lucide.createIcons();
        }

        function scheduleGeigerClick() {
            if (!audioEnabled) return;
            // Play synthetic click
            const osc = audioCtx.createOscillator();
            const gain = audioCtx.createGain();
            osc.type = 'triangle';
            osc.frequency.setValueAtTime(1200 + Math.random() * 400, audioCtx.currentTime);
            gain.gain.setValueAtTime(0.08, audioCtx.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.015);
            osc.connect(gain);
            gain.connect(audioCtx.destination);
            osc.start();
            osc.stop(audioCtx.currentTime + 0.015);

            // Interval based on closest target RSSI
            const closestRssi = Math.max(...targets.map(t => t.rssi));
            const delay = Math.max(50, Math.min(1000, (closestRssi + 100) * 12));
            setTimeout(scheduleGeigerClick, delay);
        }

        // Canvas 2D Tactical Radar Loop
        const radarCanvas = document.getElementById('radarCanvas');
        const rCtx = radarCanvas.getContext('2d');
        let radarSweepAngle = 0;

        function renderRadar() {
            const w = radarCanvas.width;
            const h = radarCanvas.height;
            const cx = w / 2;
            const cy = h / 2;
            const radius = Math.min(cx, cy) - 20;

            // Clear Background
            rCtx.fillStyle = '#050b14';
            rCtx.fillRect(0, 0, w, h);

            // Polar Grid Rings
            rCtx.strokeStyle = 'rgba(0, 229, 255, 0.2)';
            rCtx.lineWidth = 1;
            for (let r = 1; r <= 4; r++) {
                rCtx.beginPath();
                rCtx.arc(cx, cy, (radius / 4) * r, 0, Math.PI * 2);
                rCtx.stroke();
            }

            // Crosshair Axes
            rCtx.beginPath();
            rCtx.moveTo(cx - radius, cy); rCtx.lineTo(cx + radius, cy);
            rCtx.moveTo(cx, cy - radius); rCtx.lineTo(cx, cy + radius);
            rCtx.stroke();

            // Radar Sweep Beam
            radarSweepAngle += 0.03;
            if (radarSweepAngle > Math.PI * 2) radarSweepAngle = 0;

            rCtx.beginPath();
            rCtx.moveTo(cx, cy);
            rCtx.arc(cx, cy, radius, radarSweepAngle - 0.25, radarSweepAngle);
            rCtx.closePath();
            const grad = rCtx.createRadialGradient(cx, cy, 0, cx, cy, radius);
            grad.addColorStop(0, 'rgba(0, 229, 255, 0.4)');
            grad.addColorStop(1, 'rgba(0, 229, 255, 0.0)');
            rCtx.fillStyle = grad;
            rCtx.fill();

            // Target Blips
            targets.forEach(t => {
                const rad = (t.angle * Math.PI) / 180;
                const bx = cx + Math.cos(rad) * (t.dist * radius);
                const by = cy + Math.sin(rad) * (t.dist * radius);

                rCtx.beginPath();
                rCtx.arc(bx, by, 6, 0, Math.PI * 2);
                rCtx.fillStyle = t.family === 'fuel' ? '#f59e0b' : '#00e5ff';
                rCtx.fill();
                rCtx.shadowBlur = 10;
                rCtx.shadowColor = rCtx.fillStyle;

                // Label
                rCtx.fillStyle = '#ffffff';
                rCtx.font = '10px monospace';
                rCtx.fillText(`${t.name} (${t.rssi}dBm)`, bx + 8, by + 3);
            });

            requestAnimationFrame(renderRadar);
        }
        renderRadar();

        // Spectrum Waterfall Canvas Loop
        const specCanvas = document.getElementById('spectrumCanvas');
        const sCtx = specCanvas.getContext('2d');

        function renderSpectrum() {
            sCtx.fillStyle = 'rgba(5, 11, 20, 0.2)';
            sCtx.fillRect(0, 0, specCanvas.width, specCanvas.height);

            sCtx.strokeStyle = '#00e5ff';
            sCtx.lineWidth = 1.5;
            sCtx.beginPath();
            const sliceWidth = specCanvas.width / 20;
            let x = 0;

            for (let i = 0; i < 20; i++) {
                const y = (Math.sin(i * 0.5 + Date.now() * 0.005) * 20) + (specCanvas.height / 2);
                if (i === 0) sCtx.moveTo(x, y);
                else sCtx.lineTo(x, y);
                x += sliceWidth;
            }
            sCtx.stroke();
            requestAnimationFrame(renderSpectrum);
        }
        renderSpectrum();

        // Connect to MQTT Broker (ws://192.168.100.10:9001)
        function initMqtt() {
            try {
                mqttClient = mqtt.connect('ws://192.168.100.10:9001');
                
                mqttClient.on('connect', () => {
                    document.getElementById('mqttStatusBadge').className = 'flex items-center space-x-2 px-3 py-1 rounded-full text-xs font-mono bg-green-500/10 text-green-400 border border-green-500/30';
                    document.getElementById('mqttStatusText').innerText = 'MOSQUITTO ONLINE (1883/9001)';
                    mqttClient.subscribe('scannerpro/collab/+/report');
                });

                mqttClient.on('error', () => {
                    document.getElementById('mqttStatusBadge').className = 'flex items-center space-x-2 px-3 py-1 rounded-full text-xs font-mono bg-amber-500/10 text-amber-400 border border-amber-500/30';
                    document.getElementById('mqttStatusText').innerText = 'BROKER EN MODO SIMULACIÓN';
                });
            } catch (e) {
                console.warn('MQTT Connection Fallback to Offline Simulator');
            }
        }
        initMqtt();

        // Copy Firmware Code
        function copyFirmwareConfig() {
            const code = document.getElementById('cppCodeBlock').innerText;
            navigator.clipboard.writeText(code);
            alert('¡Código config.h copiado al portapapeles!');
        }
    </script>
